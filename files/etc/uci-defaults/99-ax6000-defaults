#!/bin/sh

# 统一将默认主题切换到最新版 Argon。
uci -q set luci.main.mediaurlbase='/luci-static/argon'

# 512 MiB 设备使用按需分配的 zram，缓冲 Mihomo 的瞬时内存峰值。
uci -q set system.@system[0].zram_size_mb='192'
uci -q set system.@system[0].zram_comp_algo='lzo'

# 兼容新版 LuCI 的每网络防火墙字段，缺省时恢复旧版自动 NAT 行为。
if ! uci -q get zerotier.global.nat >/dev/null; then
	uci -q set zerotier.global.nat='1'
fi

uci -q commit luci
uci -q commit system
uci -q commit zerotier

exit 0
